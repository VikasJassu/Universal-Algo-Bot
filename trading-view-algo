//@version=6
indicator("Gold + Crypto Intraday S/R + Liquidity Sweeps (MTF, Filtered)", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=1000)

// ============================================================
// Multi-asset intraday indicator (Gold or Crypto)
// Select "Market Mode" to switch between gold-tuned and crypto-tuned settings.
// All existing gold settings are preserved; crypto mode applies overrides.
// ============================================================

// ------------------------- MARKET MODE -------------------------
marketMode = input.string("Gold", "Market Mode", options=["Gold","Crypto","Crude"], group="Market Mode", tooltip="Gold = XAUUSD tuned; Crypto = BTC/ETH tuned (24/7); Crude = CL/USOIL tuned (NY pit session, wider wick)")
isCrypto   = marketMode == "Crypto"
isCrude    = marketMode == "Crude"

// ------------------------- CRYPTO OVERRIDES -------------------------
cryptoAtrMult    = input.float(0.8, "Crypto: Min Wick x ATR", minval=0.1, step=0.1, group="Crypto Overrides (used only in Crypto mode)")
cryptoLiqTol     = input.float(50,  "Crypto: Equal H/L Tolerance (ticks)", minval=1, group="Crypto Overrides (used only in Crypto mode)")
cryptoUseSession = input.bool(false, "Crypto: Use Session Filter (default off — crypto is 24/7)", group="Crypto Overrides (used only in Crypto mode)")
cryptoUsSess     = input.session("1300-2100", "Crypto: US Volume Window (UTC)", group="Crypto Overrides (used only in Crypto mode)", tooltip="Only used if session filter enabled; covers 6:30 PM–2:30 AM IST")
cryptoHtfTF      = input.string("60", "Crypto: HTF Bias TF", options=["30","60","240"], group="Crypto Overrides (used only in Crypto mode)")
cryptoPivot      = input.int(3, "Crypto: Pivot Bars (L=R)", minval=1, group="Crypto Overrides (used only in Crypto mode)")
cryptoSlBuffer   = input.float(0.8, "Crypto: SL Buffer x ATR", minval=0, step=0.1, group="Crypto Overrides (used only in Crypto mode)")

// ------------------------- CRUDE OIL OVERRIDES -------------------------
crudeAtrMult    = input.float(0.6,  "Crude: Min Wick x ATR", minval=0.1, step=0.1, group="Crude Overrides (used only in Crude mode)")
crudeLiqTol     = input.float(50,   "Crude: Equal H/L Tolerance (ticks)", minval=1, group="Crude Overrides (used only in Crude mode)")
crudeMergeTicks = input.float(80,   "Crude: Merge Zones Within (ticks)", minval=1, group="Crude Overrides (used only in Crude mode)")
crudeUseSession = input.bool(true,  "Crude: Use Session Filter", group="Crude Overrides (used only in Crude mode)")
crudeNySess     = input.session("1430-1630", "Crude: NY Pit Session (GMT)", group="Crude Overrides (used only in Crude mode)", tooltip="Crude's NY killzone is later than gold's — covers pit open + Wed EIA")
crudeHtfTF      = input.string("240", "Crude: HTF Bias TF", options=["60","240","D"], group="Crude Overrides (used only in Crude mode)")
crudePivot      = input.int(5,      "Crude: Pivot Bars (L=R)", minval=1, group="Crude Overrides (used only in Crude mode)")
crudeSlBuffer   = input.float(0.6,  "Crude: SL Buffer x ATR", minval=0, step=0.1, group="Crude Overrides (used only in Crude mode)")

// ------------------------- INPUTS -------------------------
showDayHL   = input.bool(true, "Show Day High/Low", group="Day Levels")
dayHighCol  = input.color(color.red, "Day High Color", group="Day Levels")
dayLowCol   = input.color(color.lime, "Day Low Color", group="Day Levels")

show4H  = input.bool(true, "Show 4H S/R", group="Multi-Timeframe S/R")
show1H  = input.bool(true, "Show 1H S/R", group="Multi-Timeframe S/R")
show5M  = input.bool(true, "Show 5min S/R", group="Multi-Timeframe S/R")
show1M  = input.bool(true, "Show 1min S/R (chart must be 1min)", group="Multi-Timeframe S/R")
pivotLeft      = input.int(5, "Pivot Left Bars", minval=1, group="Multi-Timeframe S/R")
pivotRight     = input.int(5, "Pivot Right Bars", minval=1, group="Multi-Timeframe S/R")
maxLevelsPerTF = input.int(3, "Max Levels to Keep per TF", minval=1, maxval=10, group="Multi-Timeframe S/R")

showLiquidity = input.bool(true, "Show Equal High/Low Liquidity Pools", group="Liquidity")
liqTolTicks   = input.float(10, "Equal High/Low Tolerance (ticks)", minval=1, group="Liquidity")
liqMemory     = input.int(20, "Pivots Remembered for Liquidity Check", minval=5, maxval=50, group="Liquidity")

showSweeps    = input.bool(true, "Show Liquidity Sweeps", group="Liquidity Sweeps")

// --- Session filter (times in exchange timezone; TradingView uses chart TZ) ---
useSessionFilter = input.bool(true, "Only Signal During Killzones", group="Filters: Session")
londonSess   = input.session("0700-1000", "London Killzone (GMT)", group="Filters: Session")
nySess       = input.session("1230-1500", "NY AM Killzone (GMT)",  group="Filters: Session")
overlapSess  = input.session("1200-1600", "London/NY Overlap (GMT)", group="Filters: Session")
sessionTZ    = input.string("GMT", "Session Timezone", options=["GMT","America/New_York","Europe/London","Asia/Tokyo"], group="Filters: Session")

// --- HTF bias filter ---
useHTFBias = input.bool(true, "Use 4H EMA Bias Filter", group="Filters: HTF Bias")
htfEmaLen  = input.int(50, "HTF EMA Length", minval=10, group="Filters: HTF Bias")
htfTF      = input.string("240", "HTF Timeframe for Bias", options=["60","240","D"], group="Filters: HTF Bias")

// --- ATR sweep validation ---
useAtrSweep = input.bool(true, "Require Meaningful Sweep Wick (ATR)", group="Filters: Sweep Quality")
atrLen      = input.int(14, "ATR Length", minval=1, group="Filters: Sweep Quality")
atrWickMult = input.float(0.5, "Min Wick Size (x ATR)", minval=0.1, step=0.1, group="Filters: Sweep Quality")

// --- Chart Cleanup ---
hideOldVisuals   = input.bool(true,  "Hide Old Sweeps & Liquidity Pools", group="Chart Cleanup")
lookbackHours    = input.float(4,    "Keep Only Last N Hours of Visuals", minval=0.5, step=0.5, group="Chart Cleanup", tooltip="Anything older than this is auto-deleted from the chart")
autoRemoveSwept  = input.bool(true,  "Auto-Remove Swept BSL/SSL Levels",  group="Chart Cleanup", tooltip="Delete a liquidity level once price has closed through it — that liquidity is already taken and no longer relevant")
maxActiveLevels  = input.int(4,      "Max Active BSL/SSL Levels",         minval=1, maxval=15, group="Chart Cleanup", tooltip="Cap on visible BSL/SSL zones; oldest auto-deleted when exceeded")
mergeZoneTicks   = input.float(30,   "Merge Zones Within (ticks)",        minval=1, group="Chart Cleanup", tooltip="Skip drawing a new BSL/SSL if one already exists within this distance — prevents stacked duplicate lines")

// --- Trade Management ---
enableTradeMgmt = input.bool(true, "Enable Trade Management (SL/TP)", group="Trade Management")
slAtrBuffer     = input.float(0.5, "SL Buffer (x ATR beyond sweep wick)", minval=0, step=0.1, group="Trade Management")
tp1PctExit      = input.float(50, "TP1 Exit %", minval=0, maxval=100, group="Trade Management")
tp2PctExit      = input.float(30, "TP2 Exit %", minval=0, maxval=100, group="Trade Management")
tp3PctExit      = input.float(20, "TP3 Exit % (runner)", minval=0, maxval=100, group="Trade Management")
useTrailing     = input.bool(true, "Hybrid Trailing (BE at TP1, structure after TP2)", group="Trade Management")

// ------------------------- EFFECTIVE VALUES (mode-aware) -------------------------
// Gold mode uses the original inputs; Crypto/Crude modes swap in their overrides.
effAtrWickMult   = isCrypto ? cryptoAtrMult    : isCrude ? crudeAtrMult    : atrWickMult
effLiqTolTicks   = isCrypto ? cryptoLiqTol     : isCrude ? crudeLiqTol     : liqTolTicks
effUseSession    = isCrypto ? cryptoUseSession : isCrude ? crudeUseSession : useSessionFilter
effHtfTF         = isCrypto ? cryptoHtfTF      : isCrude ? crudeHtfTF      : htfTF
effPivotLeft     = isCrypto ? cryptoPivot      : isCrude ? crudePivot      : pivotLeft
effPivotRight    = isCrypto ? cryptoPivot      : isCrude ? crudePivot      : pivotRight
effSlAtrBuffer   = isCrypto ? cryptoSlBuffer   : isCrude ? crudeSlBuffer   : slAtrBuffer
effMergeTicks    = isCrude  ? crudeMergeTicks  : mergeZoneTicks

// ------------------------- DAY HIGH / LOW -------------------------
var float dHigh = na
var float dLow  = na
newDay = ta.change(time("D")) != 0

if newDay
    dHigh := high
    dLow  := low
else
    dHigh := math.max(nz(dHigh, high), high)
    dLow  := math.min(nz(dLow, low), low)

var line dHighLine = na
var line dLowLine  = na
var label dHighLbl = na
var label dLowLbl  = na

if showDayHL
    if newDay
        line.delete(dHighLine)
        line.delete(dLowLine)
        label.delete(dHighLbl)
        label.delete(dLowLbl)
        dHighLine := line.new(bar_index, dHigh, bar_index + 1, dHigh, extend=extend.right, color=dayHighCol, width=2, style=line.style_dashed)
        dLowLine  := line.new(bar_index, dLow, bar_index + 1, dLow, extend=extend.right, color=dayLowCol, width=2, style=line.style_dashed)
        dHighLbl  := label.new(bar_index, dHigh, "Day High", style=label.style_label_left, color=dayHighCol, textcolor=color.white, size=size.tiny)
        dLowLbl   := label.new(bar_index, dLow, "Day Low", style=label.style_label_left, color=dayLowCol, textcolor=color.white, size=size.tiny)
    else
        line.set_y1(dHighLine, dHigh)
        line.set_y2(dHighLine, dHigh)
        line.set_y1(dLowLine, dLow)
        line.set_y2(dLowLine, dLow)
        label.set_xy(dHighLbl, bar_index, dHigh)
        label.set_xy(dLowLbl, bar_index, dLow)

// ------------------------- HTF PIVOT HELPERS -------------------------
f_htf_pivot_high(tf) =>
    request.security(syminfo.tickerid, tf, ta.pivothigh(high, effPivotLeft, effPivotRight), lookahead=barmerge.lookahead_off)

f_htf_pivot_low(tf) =>
    request.security(syminfo.tickerid, tf, ta.pivotlow(low, effPivotLeft, effPivotRight), lookahead=barmerge.lookahead_off)

f_add_level(arr, price, col, w, sty) =>
    ln = line.new(bar_index, price, bar_index + 1, price, extend=extend.right, color=col, width=w, style=sty)
    array.push(arr, ln)
    if array.size(arr) > maxLevelsPerTF
        line.delete(array.shift(arr))

// ------------------------- 4H S/R -------------------------
var array<line> res4H = array.new<line>()
var array<line> sup4H = array.new<line>()
ph4H = show4H ? f_htf_pivot_high("240") : na
pl4H = show4H ? f_htf_pivot_low("240")  : na
if not na(ph4H)
    f_add_level(res4H, ph4H, color.new(color.red, 20), 2, line.style_solid)
if not na(pl4H)
    f_add_level(sup4H, pl4H, color.new(color.lime, 20), 2, line.style_solid)

// ------------------------- 1H S/R -------------------------
var array<line> res1H = array.new<line>()
var array<line> sup1H = array.new<line>()
var float last1Hph = na
var float last1Hpl = na
ph1H = show1H ? f_htf_pivot_high("60") : na
pl1H = show1H ? f_htf_pivot_low("60")  : na
if not na(ph1H)
    f_add_level(res1H, ph1H, color.new(color.orange, 20), 1, line.style_solid)
    last1Hph := ph1H
if not na(pl1H)
    f_add_level(sup1H, pl1H, color.new(color.blue, 20), 1, line.style_solid)
    last1Hpl := pl1H

// ------------------------- 5min S/R -------------------------
var array<line> res5M = array.new<line>()
var array<line> sup5M = array.new<line>()
ph5M = show5M ? f_htf_pivot_high("5") : na
pl5M = show5M ? f_htf_pivot_low("5")  : na
if not na(ph5M)
    f_add_level(res5M, ph5M, color.new(color.purple, 40), 1, line.style_solid)
if not na(pl5M)
    f_add_level(sup5M, pl5M, color.new(color.teal, 40), 1, line.style_solid)

// ------------------------- 1min S/R -------------------------
var array<line> res1M = array.new<line>()
var array<line> sup1M = array.new<line>()
ph1M = (show1M and timeframe.period == "1") ? ta.pivothigh(high, effPivotLeft, effPivotRight) : na
pl1M = (show1M and timeframe.period == "1") ? ta.pivotlow(low, effPivotLeft, effPivotRight)   : na
if not na(ph1M)
    f_add_level(res1M, ph1M, color.new(color.gray, 30), 1, line.style_dotted)
if not na(pl1M)
    f_add_level(sup1M, pl1M, color.new(color.gray, 30), 1, line.style_dotted)

// ------------------------- LIQUIDITY POOLS (Equal Highs/Lows) -------------------------
ph = ta.pivothigh(high, effPivotLeft, effPivotRight)
pl = ta.pivotlow(low, effPivotLeft, effPivotRight)

// Track most recent chart-TF pivots for structure targets/trailing
var float lastPHchart = na
var float lastPLchart = na
if not na(ph)
    lastPHchart := ph
if not na(pl)
    lastPLchart := pl

var array<float> recentHighs    = array.new<float>()
var array<int>   recentHighBars = array.new<int>()
var array<float> recentLows     = array.new<float>()
var array<int>   recentLowBars  = array.new<int>()

var float lastBSL = na
var float lastSSL = na

// Tracking arrays for cleanup of old visuals
var array<line>  liqPoolLines  = array.new<line>()
var array<label> liqPoolLabels = array.new<label>()
var array<int>   liqPoolBars   = array.new<int>()
var array<float> liqPoolPrices = array.new<float>()
var array<int>   liqPoolTypes  = array.new<int>()  // 1 = BSL, -1 = SSL
var array<label> sweepMarks    = array.new<label>()
var array<int>   sweepMarkBars = array.new<int>()

if showLiquidity and not na(ph)
    newHigh    = ph
    newHighBar = bar_index - effPivotRight
    if array.size(recentHighs) > 0
        for i = 0 to array.size(recentHighs) - 1
            prevHigh = array.get(recentHighs, i)
            if math.abs(newHigh - prevHigh) <= effLiqTolTicks * syminfo.mintick
                avgPrice = (newHigh + prevHigh) / 2
                // Skip if we already have a BSL zone near this price
                duplicate = false
                if array.size(liqPoolPrices) > 0
                    for j = 0 to array.size(liqPoolPrices) - 1
                        if array.get(liqPoolTypes, j) == 1 and math.abs(array.get(liqPoolPrices, j) - avgPrice) <= effMergeTicks * syminfo.mintick
                            duplicate := true
                            break
                if not duplicate
                    startBar = math.max(array.get(recentHighBars, i), bar_index - 900)
                    bslLn  = line.new(startBar, avgPrice, newHighBar, avgPrice, color=color.new(color.fuchsia, 0), width=2)
                    bslLbl = label.new(newHighBar, avgPrice, "BSL", style=label.style_label_down, color=color.fuchsia, textcolor=color.white, size=size.tiny)
                    array.push(liqPoolLines, bslLn)
                    array.push(liqPoolLabels, bslLbl)
                    array.push(liqPoolBars, bar_index)
                    array.push(liqPoolPrices, avgPrice)
                    array.push(liqPoolTypes, 1)
                    lastBSL := avgPrice
    array.push(recentHighs, newHigh)
    array.push(recentHighBars, newHighBar)
    if array.size(recentHighs) > liqMemory
        array.shift(recentHighs)
        array.shift(recentHighBars)

if showLiquidity and not na(pl)
    newLow    = pl
    newLowBar = bar_index - effPivotRight
    if array.size(recentLows) > 0
        for i = 0 to array.size(recentLows) - 1
            prevLow = array.get(recentLows, i)
            if math.abs(newLow - prevLow) <= effLiqTolTicks * syminfo.mintick
                avgPrice = (newLow + prevLow) / 2
                duplicate = false
                if array.size(liqPoolPrices) > 0
                    for j = 0 to array.size(liqPoolPrices) - 1
                        if array.get(liqPoolTypes, j) == -1 and math.abs(array.get(liqPoolPrices, j) - avgPrice) <= effMergeTicks * syminfo.mintick
                            duplicate := true
                            break
                if not duplicate
                    startBar = math.max(array.get(recentLowBars, i), bar_index - 900)
                    sslLn  = line.new(startBar, avgPrice, newLowBar, avgPrice, color=color.new(color.aqua, 0), width=2)
                    sslLbl = label.new(newLowBar, avgPrice, "SSL", style=label.style_label_up, color=color.aqua, textcolor=color.black, size=size.tiny)
                    array.push(liqPoolLines, sslLn)
                    array.push(liqPoolLabels, sslLbl)
                    array.push(liqPoolBars, bar_index)
                    array.push(liqPoolPrices, avgPrice)
                    array.push(liqPoolTypes, -1)
                    lastSSL := avgPrice
    array.push(recentLows, newLow)
    array.push(recentLowBars, newLowBar)
    if array.size(recentLows) > liqMemory
        array.shift(recentLows)
        array.shift(recentLowBars)

// ------------------------- FILTERS -------------------------

// Session filter: gold = London/NY/Overlap; crypto = US volume window; crude = London/NY-pit/Overlap
inLondon   = not na(time(timeframe.period, londonSess,   sessionTZ))
inNY       = not na(time(timeframe.period, nySess,       sessionTZ))
inOverlap  = not na(time(timeframe.period, overlapSess,  sessionTZ))
inCryptoUS = not na(time(timeframe.period, cryptoUsSess, "GMT"))
inCrudeNY  = not na(time(timeframe.period, crudeNySess,  sessionTZ))
inKillzone = isCrypto ? inCryptoUS : isCrude ? (inLondon or inCrudeNY or inOverlap) : (inLondon or inNY or inOverlap)
sessionOK  = effUseSession ? inKillzone : true

// HTF bias filter
htfEma   = request.security(syminfo.tickerid, effHtfTF, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
bullBias = close > htfEma
bearBias = close < htfEma
longBiasOK  = useHTFBias ? bullBias : true
shortBiasOK = useHTFBias ? bearBias : true

// ATR-based wick validation
atrVal    = ta.atr(atrLen)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
wickUpOK  = useAtrSweep ? (upperWick >= atrVal * effAtrWickMult) : true
wickDnOK  = useAtrSweep ? (lowerWick >= atrVal * effAtrWickMult) : true

// ------------------------- LIQUIDITY SWEEP DETECTION -------------------------
// Raw sweep patterns
rawSweepDayHigh = showSweeps and showDayHL and not newDay and high > dHigh[1] and close < dHigh[1]
rawSweepDayLow  = showSweeps and showDayHL and not newDay and low  < dLow[1]  and close > dLow[1]
rawSweep1H_R = showSweeps and show1H and not na(last1Hph) and high > last1Hph and close < last1Hph
rawSweep1H_S = showSweeps and show1H and not na(last1Hpl) and low  < last1Hpl and close > last1Hpl
rawSweepBSL = showSweeps and showLiquidity and not na(lastBSL) and high > lastBSL and close < lastBSL
rawSweepSSL = showSweeps and showLiquidity and not na(lastSSL) and low  < lastSSL and close > lastSSL

// Apply filters — bearish sweeps (highs swept) need short bias; bullish sweeps (lows swept) need long bias
sweepDayHigh = rawSweepDayHigh and sessionOK and shortBiasOK and wickUpOK
sweepDayLow  = rawSweepDayLow  and sessionOK and longBiasOK  and wickDnOK
sweep1H_R    = rawSweep1H_R    and sessionOK and shortBiasOK and wickUpOK
sweep1H_S    = rawSweep1H_S    and sessionOK and longBiasOK  and wickDnOK
sweepBSL     = rawSweepBSL     and sessionOK and shortBiasOK and wickUpOK
sweepSSL     = rawSweepSSL     and sessionOK and longBiasOK  and wickDnOK

// ------------------------- TRADE MANAGEMENT (SL / TP1-2-3 / Partials / Trailing) -------------------------
longSignal  = enableTradeMgmt and (sweepDayLow  or sweep1H_S or sweepSSL)
shortSignal = enableTradeMgmt and (sweepDayHigh or sweep1H_R or sweepBSL)

var int   tradeDir   = 0
var float entryPrice = na
var float currentSL  = na
var float tp1Price   = na
var float tp2Price   = na
var float tp3Price   = na
var bool  tp1Hit     = false
var bool  tp2Hit     = false
var bool  tp3Hit     = false
var line  entryLine  = na
var line  slLine     = na
var line  tp1Line    = na
var line  tp2Line    = na
var line  tp3Line    = na
var label entryLabel = na

// --- Open LONG ---
if longSignal and tradeDir == 0
    entryPrice := close
    currentSL  := low - atrVal * effSlAtrBuffer
    risk       = entryPrice - currentSL
    tp1Price   := not na(lastPHchart) and lastPHchart > entryPrice + risk * 0.5 ? lastPHchart : entryPrice + risk * 1
    tp2Price   := not na(lastBSL)     and lastBSL     > tp1Price               ? lastBSL     : entryPrice + risk * 2
    tp3Price   := dHigh > tp2Price ? dHigh : entryPrice + risk * 3
    entryLine  := line.new(bar_index, entryPrice, bar_index + 1, entryPrice, color=color.white,   width=1, style=line.style_solid,  extend=extend.right)
    slLine     := line.new(bar_index, currentSL,  bar_index + 1, currentSL,  color=color.red,     width=2, style=line.style_dashed, extend=extend.right)
    tp1Line    := line.new(bar_index, tp1Price,   bar_index + 1, tp1Price,   color=color.lime,    width=1, style=line.style_dotted, extend=extend.right)
    tp2Line    := line.new(bar_index, tp2Price,   bar_index + 1, tp2Price,   color=color.lime,    width=1, style=line.style_dotted, extend=extend.right)
    tp3Line    := line.new(bar_index, tp3Price,   bar_index + 1, tp3Price,   color=color.lime,    width=2, style=line.style_dotted, extend=extend.right)
    txt = "LONG @ " + str.tostring(entryPrice, "#.##") + "\nSL: " + str.tostring(currentSL, "#.##") + "\nTP1 (" + str.tostring(tp1PctExit, "#") + "%): " + str.tostring(tp1Price, "#.##") + "\nTP2 (" + str.tostring(tp2PctExit, "#") + "%): " + str.tostring(tp2Price, "#.##") + "\nTP3 (" + str.tostring(tp3PctExit, "#") + "%): " + str.tostring(tp3Price, "#.##")
    entryLabel := label.new(bar_index, entryPrice, txt, style=label.style_label_right, color=color.new(color.green, 15), textcolor=color.white, size=size.small)
    tp1Hit := false
    tp2Hit := false
    tp3Hit := false
    tradeDir := 1
    alert("GOLD LONG entry @ " + str.tostring(entryPrice, "#.##") + " | SL " + str.tostring(currentSL, "#.##") + " | TP1 " + str.tostring(tp1Price, "#.##") + " | TP2 " + str.tostring(tp2Price, "#.##") + " | TP3 " + str.tostring(tp3Price, "#.##"), alert.freq_once_per_bar_close)

// --- Open SHORT ---
if shortSignal and tradeDir == 0
    entryPrice := close
    currentSL  := high + atrVal * effSlAtrBuffer
    risk       = currentSL - entryPrice
    tp1Price   := not na(lastPLchart) and lastPLchart < entryPrice - risk * 0.5 ? lastPLchart : entryPrice - risk * 1
    tp2Price   := not na(lastSSL)     and lastSSL     < tp1Price               ? lastSSL     : entryPrice - risk * 2
    tp3Price   := dLow < tp2Price ? dLow : entryPrice - risk * 3
    entryLine  := line.new(bar_index, entryPrice, bar_index + 1, entryPrice, color=color.white,   width=1, style=line.style_solid,  extend=extend.right)
    slLine     := line.new(bar_index, currentSL,  bar_index + 1, currentSL,  color=color.red,     width=2, style=line.style_dashed, extend=extend.right)
    tp1Line    := line.new(bar_index, tp1Price,   bar_index + 1, tp1Price,   color=color.lime,    width=1, style=line.style_dotted, extend=extend.right)
    tp2Line    := line.new(bar_index, tp2Price,   bar_index + 1, tp2Price,   color=color.lime,    width=1, style=line.style_dotted, extend=extend.right)
    tp3Line    := line.new(bar_index, tp3Price,   bar_index + 1, tp3Price,   color=color.lime,    width=2, style=line.style_dotted, extend=extend.right)
    txt = "SHORT @ " + str.tostring(entryPrice, "#.##") + "\nSL: " + str.tostring(currentSL, "#.##") + "\nTP1 (" + str.tostring(tp1PctExit, "#") + "%): " + str.tostring(tp1Price, "#.##") + "\nTP2 (" + str.tostring(tp2PctExit, "#") + "%): " + str.tostring(tp2Price, "#.##") + "\nTP3 (" + str.tostring(tp3PctExit, "#") + "%): " + str.tostring(tp3Price, "#.##")
    entryLabel := label.new(bar_index, entryPrice, txt, style=label.style_label_right, color=color.new(color.red, 15), textcolor=color.white, size=size.small)
    tp1Hit := false
    tp2Hit := false
    tp3Hit := false
    tradeDir := -1
    alert("GOLD SHORT entry @ " + str.tostring(entryPrice, "#.##") + " | SL " + str.tostring(currentSL, "#.##") + " | TP1 " + str.tostring(tp1Price, "#.##") + " | TP2 " + str.tostring(tp2Price, "#.##") + " | TP3 " + str.tostring(tp3Price, "#.##"), alert.freq_once_per_bar_close)

// --- Manage active LONG ---
if tradeDir == 1
    if not tp1Hit and high >= tp1Price
        tp1Hit := true
        label.new(bar_index, tp1Price, "TP1 HIT — Exit " + str.tostring(tp1PctExit, "#") + "%", style=label.style_label_down, color=color.lime, textcolor=color.black, size=size.tiny)
        if useTrailing
            currentSL := entryPrice
            line.set_y1(slLine, currentSL)
            line.set_y2(slLine, currentSL)
            label.new(bar_index, currentSL, "SL → BE", style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.tiny)
        alert("GOLD LONG TP1 hit @ " + str.tostring(tp1Price, "#.##") + " — exit " + str.tostring(tp1PctExit, "#") + "%, move SL to BE", alert.freq_once_per_bar_close)
    if not tp2Hit and high >= tp2Price
        tp2Hit := true
        label.new(bar_index, tp2Price, "TP2 HIT — Exit " + str.tostring(tp2PctExit, "#") + "%", style=label.style_label_down, color=color.lime, textcolor=color.black, size=size.tiny)
        if useTrailing and not na(lastPLchart) and lastPLchart > currentSL and lastPLchart < close
            currentSL := lastPLchart
            line.set_y1(slLine, currentSL)
            line.set_y2(slLine, currentSL)
            label.new(bar_index, currentSL, "SL → Structure", style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.tiny)
        alert("GOLD LONG TP2 hit @ " + str.tostring(tp2Price, "#.##") + " — exit " + str.tostring(tp2PctExit, "#") + "%, trail SL to structure", alert.freq_once_per_bar_close)
    if tp2Hit and useTrailing and not na(lastPLchart) and lastPLchart > currentSL and lastPLchart < close
        currentSL := lastPLchart
        line.set_y1(slLine, currentSL)
        line.set_y2(slLine, currentSL)
    if not tp3Hit and high >= tp3Price
        tp3Hit := true
        label.new(bar_index, tp3Price, "TP3 HIT — Exit runner " + str.tostring(tp3PctExit, "#") + "%", style=label.style_label_down, color=color.lime, textcolor=color.black, size=size.small)
        alert("GOLD LONG TP3 hit @ " + str.tostring(tp3Price, "#.##") + " — close remaining " + str.tostring(tp3PctExit, "#") + "%", alert.freq_once_per_bar_close)
        line.delete(entryLine)
        line.delete(slLine)
        line.delete(tp1Line)
        line.delete(tp2Line)
        line.delete(tp3Line)
        label.delete(entryLabel)
        tradeDir := 0
    if tradeDir == 1 and low <= currentSL
        label.new(bar_index, currentSL, tp1Hit ? "Trail Exit" : "SL HIT", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
        alert("GOLD LONG " + (tp1Hit ? "trail exit" : "STOP hit") + " @ " + str.tostring(currentSL, "#.##"), alert.freq_once_per_bar_close)
        line.delete(entryLine)
        line.delete(slLine)
        line.delete(tp1Line)
        line.delete(tp2Line)
        line.delete(tp3Line)
        label.delete(entryLabel)
        tradeDir := 0

// --- Manage active SHORT ---
if tradeDir == -1
    if not tp1Hit and low <= tp1Price
        tp1Hit := true
        label.new(bar_index, tp1Price, "TP1 HIT — Exit " + str.tostring(tp1PctExit, "#") + "%", style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.tiny)
        if useTrailing
            currentSL := entryPrice
            line.set_y1(slLine, currentSL)
            line.set_y2(slLine, currentSL)
            label.new(bar_index, currentSL, "SL → BE", style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.tiny)
        alert("GOLD SHORT TP1 hit @ " + str.tostring(tp1Price, "#.##") + " — exit " + str.tostring(tp1PctExit, "#") + "%, move SL to BE", alert.freq_once_per_bar_close)
    if not tp2Hit and low <= tp2Price
        tp2Hit := true
        label.new(bar_index, tp2Price, "TP2 HIT — Exit " + str.tostring(tp2PctExit, "#") + "%", style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.tiny)
        if useTrailing and not na(lastPHchart) and lastPHchart < currentSL and lastPHchart > close
            currentSL := lastPHchart
            line.set_y1(slLine, currentSL)
            line.set_y2(slLine, currentSL)
            label.new(bar_index, currentSL, "SL → Structure", style=label.style_label_left, color=color.yellow, textcolor=color.black, size=size.tiny)
        alert("GOLD SHORT TP2 hit @ " + str.tostring(tp2Price, "#.##") + " — exit " + str.tostring(tp2PctExit, "#") + "%, trail SL to structure", alert.freq_once_per_bar_close)
    if tp2Hit and useTrailing and not na(lastPHchart) and lastPHchart < currentSL and lastPHchart > close
        currentSL := lastPHchart
        line.set_y1(slLine, currentSL)
        line.set_y2(slLine, currentSL)
    if not tp3Hit and low <= tp3Price
        tp3Hit := true
        label.new(bar_index, tp3Price, "TP3 HIT — Exit runner " + str.tostring(tp3PctExit, "#") + "%", style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.small)
        alert("GOLD SHORT TP3 hit @ " + str.tostring(tp3Price, "#.##") + " — close remaining " + str.tostring(tp3PctExit, "#") + "%", alert.freq_once_per_bar_close)
        line.delete(entryLine)
        line.delete(slLine)
        line.delete(tp1Line)
        line.delete(tp2Line)
        line.delete(tp3Line)
        label.delete(entryLabel)
        tradeDir := 0
    if tradeDir == -1 and high >= currentSL
        label.new(bar_index, currentSL, tp1Hit ? "Trail Exit" : "SL HIT", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
        alert("GOLD SHORT " + (tp1Hit ? "trail exit" : "STOP hit") + " @ " + str.tostring(currentSL, "#.##"), alert.freq_once_per_bar_close)
        line.delete(entryLine)
        line.delete(slLine)
        line.delete(tp1Line)
        line.delete(tp2Line)
        line.delete(tp3Line)
        label.delete(entryLabel)
        tradeDir := 0

// ------------------------- SWEEP MARKERS (tracked for cleanup) -------------------------
f_push_sweep(_lbl) =>
    array.push(sweepMarks, _lbl)
    array.push(sweepMarkBars, bar_index)

if sweepDayHigh
    f_push_sweep(label.new(bar_index, high, "DH SWEEP", yloc=yloc.abovebar, style=label.style_xcross,      color=color.red,     textcolor=color.white, size=size.small))
if sweepDayLow
    f_push_sweep(label.new(bar_index, low,  "DL SWEEP", yloc=yloc.belowbar, style=label.style_xcross,      color=color.lime,    textcolor=color.black, size=size.small))
if sweep1H_R
    f_push_sweep(label.new(bar_index, high, "1H",       yloc=yloc.abovebar, style=label.style_triangledown, color=color.orange,  textcolor=color.white, size=size.tiny))
if sweep1H_S
    f_push_sweep(label.new(bar_index, low,  "1H",       yloc=yloc.belowbar, style=label.style_triangleup,   color=color.blue,    textcolor=color.white, size=size.tiny))
if sweepBSL
    f_push_sweep(label.new(bar_index, high, "BSL",      yloc=yloc.abovebar, style=label.style_triangledown, color=color.fuchsia, textcolor=color.white, size=size.tiny))
if sweepSSL
    f_push_sweep(label.new(bar_index, low,  "SSL",      yloc=yloc.belowbar, style=label.style_triangleup,   color=color.aqua,    textcolor=color.black, size=size.tiny))

// ------------------------- CLEANUP OLD VISUALS -------------------------
// 1. Age-based cleanup (sweep markers + liquidity zones)
if hideOldVisuals
    maxAgeBars = int(math.ceil(lookbackHours * 3600 / math.max(timeframe.in_seconds(), 60)))
    while array.size(sweepMarkBars) > 0 and (bar_index - array.get(sweepMarkBars, 0)) > maxAgeBars
        label.delete(array.shift(sweepMarks))
        array.shift(sweepMarkBars)
    while array.size(liqPoolBars) > 0 and (bar_index - array.get(liqPoolBars, 0)) > maxAgeBars
        line.delete(array.shift(liqPoolLines))
        label.delete(array.shift(liqPoolLabels))
        array.shift(liqPoolBars)
        array.shift(liqPoolPrices)
        array.shift(liqPoolTypes)

// 2. Sweep-based cleanup — remove levels once price has closed through them
if autoRemoveSwept and array.size(liqPoolPrices) > 0
    i = array.size(liqPoolPrices) - 1
    while i >= 0
        p = array.get(liqPoolPrices, i)
        t = array.get(liqPoolTypes, i)
        swept = (t == 1  and close > p) or (t == -1 and close < p)
        if swept
            line.delete(array.get(liqPoolLines, i))
            label.delete(array.get(liqPoolLabels, i))
            array.remove(liqPoolLines, i)
            array.remove(liqPoolLabels, i)
            array.remove(liqPoolBars, i)
            array.remove(liqPoolPrices, i)
            array.remove(liqPoolTypes, i)
        i := i - 1

// 3. Cap max active levels — drop oldest when over the limit
while array.size(liqPoolPrices) > maxActiveLevels
    line.delete(array.shift(liqPoolLines))
    label.delete(array.shift(liqPoolLabels))
    array.shift(liqPoolBars)
    array.shift(liqPoolPrices)
    array.shift(liqPoolTypes)

