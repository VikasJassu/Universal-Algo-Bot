if barstate.islast
    tradeStr = tradeDir == 1 ? "LONG" : tradeDir == -1 ? "SHORT" : "FLAT"
    tradeCol = tradeDir == 1 ? color.lime : tradeDir == -1 ? color.red : color.gray
    progStr  = tradeDir == 0 ? "-" : (tp3Hit ? "TP3" : tp2Hit ? "TP2 hit" : tp1Hit ? "TP1 hit" : "Open")
    table.cell(statusTbl, 0, 0, "Mode",     text_color=color.white, text_size=size.small)
