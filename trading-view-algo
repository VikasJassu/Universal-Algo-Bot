    table.cell(statusTbl, 1, 2, bullBias ? "BULL" : bearBias ? "BEAR" : "FLAT", text_color=bullBias ? color.lime : color.red, text_size=size.small)
    table.cell(statusTbl, 0, 3, "ATR",      text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 3, str.tostring(atrVal, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 0, 4, "Day Range", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 4, str.tostring(dHigh - dLow, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 0, 5, "Trade",    text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 5, tradeStr,   text_color=tradeCol,    text_size=size.small)
    table.cell(statusTbl, 0, 6, "Progress", text_color=color.white, text_size=size.small)
    table.cell(statusTbl, 1, 6, progStr,    text_color=color.white, text_size=size.small)

